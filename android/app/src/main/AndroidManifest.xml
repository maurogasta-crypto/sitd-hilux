<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- La ubicación fina es de donde sale la velocidad Doppler, que es la que
         se integra. Con la gruesa (torres de celular) no hay odometría: el
         error de velocidad es de otro orden. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <!-- Android exige pedir también la gruesa cuando se pide la fina: si el
         usuario elige "ubicación aproximada" en el diálogo, la aplicación
         recibe sólo ésta. Las muestras que lleguen así las descarta el filtro
         de precisión, y la pantalla muestra la cuenta de descartadas. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>

    <!-- El servicio en primer plano es lo que mantiene el GPS entregando con
         la pantalla apagada. Desde Android 14 no arranca sin declarar de qué
         TIPO es, y el tipo se declara además en el propio servicio (lo hace
         el complemento geolocator, con foregroundServiceType="location"). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION"/>

    <!-- `sitd-33`. El servicio en primer plano se pide con
         `enableWakeLock: true`, y el complemento hace entonces
         `wakeLock.acquire()`, que EXIGE este permiso. El complemento no lo
         declara —su manifiesto trae sólo el servicio— y hasta esta tanda la
         aplicación tampoco.

         Es la causa más probable de que el modo «Normal» no entregara NUNCA en
         el Redmi 15: tres intentos, uno con 16 satélites en uso y 43 dB-Hz, y
         cero posiciones en noventa segundos, sin un error. Sin el permiso,
         `acquire()` tira SecurityException adentro del `onListen` del canal;
         Flutter la ataja, anula el sumidero —así que las posiciones que igual
         lleguen se tiran— y la reporta por `FlutterError.reportError`, que no
         pasa por el stream. Por eso la cascada no anotó «el modo falló»: el
         error nunca le llegó.

         Es un permiso NORMAL: se concede solo al instalar, sin diálogo. -->
    <uses-permission android:name="android.permission.WAKE_LOCK"/>

    <!-- Desde Android 13 la notificación del servicio en primer plano necesita
         este permiso para VERSE. El servicio arranca igual sin él, pero queda
         sin cartel — y un servicio en primer plano invisible es justo lo que un
         Xiaomi mata sin que nadie se entere. Declararlo acá no alcanza: desde
         `sitd-11` se pide además en tiempo de ejecución, en
         `lib/features/permisos/avisos.dart`. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <!-- Desde `sitd-17` la aplicación sube el reporte de cada viaje a una base
         remota. Es el ÚNICO motivo por el que pide red, y lo que sube es el
         reporte para desarrollo: el que no lleva una sola coordenada. Desde
         `sitd-26` el recorrido también puede subir, a una colección aparte
         (`recorridos/`) y SÓLO cuando se toca el botón: nunca solo. El
         respaldo completo sigue sin salir por ningún canal automático.

         Medir sigue siendo offline: sin señal la aplicación mide exactamente
         igual y el viaje queda encolado hasta que haya red. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>

    <!-- Lo que NO se pide, a propósito: ACCESS_BACKGROUND_LOCATION. No hace
         falta — un servicio en primer plano de tipo `location`, arrancado con
         la aplicación a la vista, puede seguir recibiendo ubicación después—,
         y pedirlo abre el diálogo de "Permitir todo el tiempo", que es el más
         invasivo que tiene Android. El día que la medición arranque sola, sin
         que nadie abra la aplicación, ahí sí hará falta y entra con su
         explicación. -->
    <application
        android:label="SITD Hilux"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
