rules_version = '2';

// Reglas de Firestore para la base de SITD-Hilux — proyecto `hilux-1b6f1`.
//
// --8<-- PLANTILLA
// ════════════════════════════════════════════════════════════════════════
//  Esta es una PLANTILLA. Los dos UID van como marcadores a propósito:
//  este repositorio es PÚBLICO, y un UID real no entra nunca a un archivo.
//
//  NO se completa a mano: el panel lo hace solo. En «Sitios» → SITD-Hilux →
//  «Copiar para publicar», con los dos UID sacados de `acceso.uids` del
//  proyecto. Eso deja el texto listo para pegar en la consola de Firebase, y
//  los UID reales existen únicamente en esa pantalla — nunca en este archivo.
//
//  Los marcadores se llaman `TU-UID-ACA` y `UID-DEL-AGENTE`, igual que en
//  `reglas.txt` del panel. Hasta el 2026-09-20 el primero acá se llamaba
//  `UID-DE-MAURO`: mismo significado, nombre distinto, y el panel no lo
//  reconocía. Dos nombres para la misma cosa es exactamente el error que este
//  ecosistema ya pagó con `perm`/`permiso` — se rompe sin dar error.
// ════════════════════════════════════════════════════════════════════════
// --8<-- FIN PLANTILLA
//
// Hay exactamente tres actores y cada uno puede poco:
//
//   el TELÉFONO  crea reportes y recorridos, y LEE recorridos —sólo eso—.
//                No lee reportes, no modifica, no borra.
//                Y acá el teléfono entra como MAURO (maurogasta@gmail.com),
//                porque él decidió no crear un usuario aparte. Ver abajo.
//   el AGENTE    lee reportes y recorridos, y lee y escribe en `analisis/`.
//   Mauro        todo.
//
// **Por qué el teléfono no puede leer REPORTES, y no es exceso de celo.** El
// APK se descarga sin cuenta desde un repositorio público, así que hay que
// diseñar como si la credencial del teléfono fuera conocida. Con estas reglas,
// lo peor que puede hacer quien la tenga es escribir de más — molesto y
// visible, no grave.
//
// ════════════════════════════════════════════════════════════════════════
//  **Y por qué SÍ puede leer recorridos, que es lo que cambió el 2026-09-21.**
//
//  Mauro pidió poder volver a bajar un respaldo desde la base «por más que
//  haya puntos o coordenadas», para poder cruzar todos los datos en esta
//  etapa. Eso da vuelta una regla que este proyecto tenía escrita en cinco
//  lugares —el recorrido no sale del teléfono— y conviene que quede escrito
//  qué cambia de verdad, porque no es lo que parece:
//
//  · NO cambia nada del lado del teléfono. Quien tenga el teléfono
//    desbloqueado ya tiene el recorrido entero en su SQLite; dejarlo leer lo
//    que él mismo subió no le agrega nada.
//  · SÍ cambia que el recorrido pasa a existir en un SEGUNDO lugar, donde lo
//    protege esta regla y la cuenta de Firebase de Mauro. Y es irreversible:
//    lo escrito queda escrito aunque después se borre.
//  · Y cambia que quien consiga la credencial SIN tener el teléfono —una
//    contraseña filtrada por otro lado— puede bajarse el recorrido. Ése es
//    todo el costo nuevo, y es el motivo de las dos cosas de abajo: que
//    `recorridos` sea una colección APARTE con permiso de lectura propio, y
//    que el teléfono siga sin poder leer `reportes`.
//
//  **El paso que cierra esto del todo está pendiente y es de Mauro:** crear
//  un usuario `telefono@…` aparte, cambiar `esElTelefono()` acá abajo y
//  volver a pegar la configuración. Con eso, la credencial que vive en el
//  teléfono deja de ser la suya. Es una función de una línea, a propósito.
// ════════════════════════════════════════════════════════════════════════
//
// **Y por qué no puede modificar ni borrar:** un reporte subido es un hecho
// del pasado. Que no se pueda reescribir es lo que hace que la colección sirva
// como respaldo — que es hoy su valor más grande, porque cada tanda obliga a
// desinstalar la aplicación y eso borra la base del teléfono.

service cloud.firestore {
  match /databases/{database}/documents {

    function soyYo() {
      return request.auth != null && request.auth.uid == 'TU-UID-ACA';
    }

    // **El teléfono entra como Mauro**, porque no se creó un usuario aparte.
    // Es una decisión suya del 2026-09-19 y tiene un costo que conviene tener
    // presente: la aplicación guarda esa contraseña en el teléfono, así que
    // quien tenga el teléfono desbloqueado y sepa sacarla tiene la cuenta de
    // Mauro **de esta base** — no su cuenta de Google, que es otra cosa: la
    // contraseña de Firebase Authentication es propia de este proyecto.
    //
    // El día que moleste, se crea `telefono@…`, se cambia esta función y se
    // vuelve a pegar la configuración en el teléfono. No hace falta nada más.
    function esElTelefono() {
      return soyYo();
    }

    function esElAgente() {
      return request.auth != null && request.auth.uid == 'UID-DEL-AGENTE';
    }

    // El reporte de cada viaje. Un documento por viaje.
    match /reportes/{id} {
      // Crear sí; pisar uno que ya existe, no. Si el mismo viaje se sube dos
      // veces, la segunda rebota con un 409 — y la aplicación lo trata como
      // «ya estaba», que es lo que es.
      allow create: if esElTelefono()
                    && request.resource.data.keys().hasOnly(
                         ['json', 'sello', 'generado'])
                    && request.resource.data.json is string
                    // Un tope generoso pero real: un reporte de un viaje anda
                    // por los cientos de kilobytes, y el límite de un
                    // documento de Firestore es 1 MB.
                    && request.resource.data.json.size() < 900000;

      allow read: if soyYo() || esElAgente();

      // Un hecho del pasado no se reescribe. Borrar es sólo de Mauro.
      allow update: if false;
      allow delete: if soyYo();
    }

    // El recorrido de cada viaje: dónde estuvo la camioneta, punto por punto.
    // Un documento por viaje, y **la llave es el INSTANTE EN QUE ARRANCÓ**, no
    // el número que el viaje tiene en el teléfono. Ese número cambia —al
    // sumar un respaldo los viajes se renumeran— y usarlo haría que un viaje
    // nuevo cayera sobre el documento de otro: la escritura rebotaría con un
    // 409, la aplicación lo leería como «ya estaba» y ese viaje **nunca se
    // subiría, sin que nada avise**.
    match /recorridos/{id} {
      allow create: if esElTelefono()
                    && request.resource.data.keys().hasOnly(
                         ['datos', 'viaje', 'inicio', 'puntos', 'sello'])
                    && request.resource.data.datos is string
                    && request.resource.data.viaje is string
                    // El viaje de 5343 puntos ocupa 117 KiB con el formato de
                    // `recorrido.dart`. El tope real de un documento es 1 MB;
                    // esto deja ocho veces de margen y sigue siendo un techo.
                    && request.resource.data.datos.size() < 900000
                    && request.resource.data.inicio is int
                    && request.resource.data.puntos is int;

      // **Acá el teléfono SÍ lee.** Ver el bloque grande de arriba. Lo otro
      // que puede leer es `analisis/`, que ya podía y es otra cosa: ahí va lo
      // que yo concluyo, no dato medido ni recorrido. `reportes/` sigue
      // cerrado para él, y ésa es la que importa. Hay una prueba que compara
      // la lista completa.
      allow read: if soyYo() || esElAgente() || esElTelefono();

      // Un recorrido subido es lo que midió el receptor: no se reescribe.
      // Borrar es sólo de Mauro, y es la única forma de sacar un recorrido de
      // la nube una vez que entró.
      allow update: if false;
      allow delete: if soyYo();
    }

    // Lo que el agente CONCLUYE de esos reportes: umbrales que habría que
    // ajustar, anomalías que conviene mirar, qué cubetas faltan.
    //
    // **Es una colección aparte y no un campo adentro del reporte**, y ése es
    // el punto: un reporte subido es lo que midió el teléfono y no se toca
    // nunca. Lo que yo opino va al lado, con su fecha, y se puede rehacer sin
    // tocar el dato. Si mañana me equivoco en un análisis, se reescribe éste
    // y el reporte sigue intacto.
    match /analisis/{id} {
      allow read: if soyYo() || esElAgente() || esElTelefono();
      allow create, update: if esElAgente() || soyYo();
      allow delete: if soyYo();
    }

    // Deny por defecto: cualquier colección que no esté nombrada arriba queda
    // inaccesible para todos. Una colección nueva entra con su regla, en la
    // misma tanda — es la regla del ecosistema y acá vale igual.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
